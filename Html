<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Prasanta Engineering & Contractor - Attendance App</title>
    <style>
        :root {
            --primary: #1d3557;
            --secondary: #457b9d;
            --bg-color: #ffffff;
            --text-color: #212529;
            --light-bg: #f8f9fa;
            --red: #e63946;
            --blue: #2a9d8f;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }
        .app-container {
            width: 100%;
            max-width: 450px;
            min-height: 100vh;
            background: var(--bg-color);
            box-shadow: 0 0 20px rgba(0,0,0,0.1);
            display: flex;
            flex-direction: column;
            position: relative;
        }
        @media (min-width: 451px) {
            .app-container {
                min-height: 850px;
                border-radius: 16px;
                overflow: hidden;
                border: 1px solid #ddd;
            }
        }
        .header {
            background-color: var(--primary);
            color: white;
            padding: 20px;
            text-align: center;
        }
        .header img {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: white;
            padding: 5px;
            margin-bottom: 8px;
            object-fit: contain;
        }
        .header h1 {
            font-size: 18px;
            margin: 0;
            font-weight: 600;
        }
        .header p {
            font-size: 12px;
            margin: 4px 0 0;
            opacity: 0.8;
        }
        .content {
            padding: 20px;
            flex: 1;
            overflow-y: auto;
        }
        .screen {
            display: none;
        }
        .screen.active {
            display: block;
        }
        .btn {
            display: block;
            width: 100%;
            padding: 12px;
            margin: 12px 0;
            background: var(--primary);
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 500;
            cursor: pointer;
            text-align: center;
            text-decoration: none;
            box-sizing: border-box;
        }
        .btn:hover {
            background: var(--secondary);
        }
        .btn-outline {
            background: transparent;
            border: 2px solid var(--primary);
            color: var(--primary);
        }
        .btn-outline:hover {
            background: var(--light-bg);
        }
        input, select {
            width: 100%;
            padding: 10px;
            margin: 8px 0 16px;
            border: 1px solid #ccc;
            border-radius: 6px;
            box-sizing: border-box;
            font-size: 14px;
        }
        label {
            font-size: 13px;
            font-weight: 600;
            color: #555;
        }
        .tabs {
            display: flex;
            background: var(--light-bg);
            border-bottom: 1px solid #ddd;
        }
        .tab-btn {
            flex: 1;
            padding: 12px;
            text-align: center;
            background: none;
            border: none;
            font-weight: 600;
            cursor: pointer;
            color: #666;
            font-size: 14px;
        }
        .tab-btn.active {
            color: var(--primary);
            border-bottom: 3px solid var(--primary);
            background: white;
        }
        .card {
            background: var(--light-bg);
            border: 1px solid #e0e0e0;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 12px;
        }
        .calendar-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 6px;
            margin-top: 15px;
        }
        .calendar-day {
            aspect-ratio: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 600;
            background: #eee;
        }
        .calendar-day.present {
            background: var(--blue);
            color: white;
        }
        .calendar-day.absent {
            background: var(--red);
            color: white;
        }
        .stats-box {
            display: flex;
            justify-content: space-around;
            margin-top: 20px;
            padding: 15px;
            background: #f1faee;
            border-radius: 8px;
            text-align: center;
        }
        .back-link {
            display: inline-block;
            margin-bottom: 15px;
            color: var(--secondary);
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
        }
    </style>
</head>
<body>

<div class="app-container">
    <!-- Header -->
    <div class="header">
        <img src="https://kumararat912-dotcom.github.io/Attendance-app/favicon.ico" alt="Logo" onerror="this.src='https://cdn-icons-png.flaticon.com/512/3135/3135715.png'">
        <h1>Prasanta Engineering & Contractor</h1>
        <p>Official Attendance System</p>
    </div>

    <div class="content">
        <!-- 1. Welcome Screen -->
        <div id="screen-welcome" class="screen active">
            <div style="text-align: center; margin: 40px 0;">
                <h2 style="color: var(--primary);">Welcome</h2>
                <p style="color: #666;">Please select your login type to proceed</p>
            </div>
            <button class="btn" onclick="showScreen('screen-owner-login')">Owner Use</button>
            <button class="btn btn-outline" onclick="showScreen('screen-employee-login')">Employees Use (Email OTP)</button>
        </div>

        <!-- Owner Password Screen -->
        <div id="screen-owner-login" class="screen">
            <a href="#" class="back-link" onclick="showScreen('screen-welcome')">&larr; Back</a>
            <h3>Owner Authentication</h3>
            <label>Enter Password (Prasanta@123)</label>
            <input type="password" id="owner-pwd" placeholder="Enter password">
            <button class="btn" onclick="verifyOwner()">Login</button>
        </div>

        <!-- Owner Dashboard -->
        <div id="screen-owner-dashboard" class="screen">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                <h3 style="margin:0;">Owner Portal</h3>
                <button class="btn-outline" style="padding: 5px 10px; width: auto; font-size: 12px; margin:0;" onclick="showScreen('screen-welcome')">Logout</button>
            </div>
            
            <div class="tabs" style="margin-top: 15px;">
                <button class="tab-btn active" onclick="switchOwnerTab('home')">Home Tab</button>
                <button class="tab-btn" onclick="switchOwnerTab('add')">Add Employees</button>
            </div>

            <!-- Owner Home Tab -->
            <div id="owner-tab-home" style="margin-top: 15px;">
                <input type="text" id="search-employee" placeholder="Search employee by name or email..." oninput="filterEmployees()">
                <div id="employee-list-container">
                    <!-- Dynamic Employee Attendance List -->
                </div>
            </div>

            <!-- Owner Add Employees Tab -->
            <div id="owner-tab-add" style="margin-top: 15px; display: none;">
                <h4>Add New Employee</h4>
                <label>Employee Photo</label>
                <input type="file" id="emp-photo" accept="image/*">
                <label>Employee Name</label>
                <input type="text" id="emp-name" placeholder="Full Name">
                <label>Email Address (For OTP Login)</label>
                <input type="email" id="emp-email" placeholder="employee@gmail.com">
                <label>Date of Birth</label>
                <input type="date" id="emp-dob">
                <label>Aadhar No</label>
                <input type="text" id="emp-aadhar" placeholder="12-digit Aadhar number">
                <label>Joining Date</label>
                <input type="date" id="emp-joining">
                <label>Position / Designation</label>
                <input type="text" id="emp-position" placeholder="e.g. Operator, Supervisor">
                <button class="btn" onclick="createEmployee()">Generate Employee & ID</button>
            </div>
        </div>

        <!-- Employee Login Screen (Email & OTP) -->
        <div id="screen-employee-login" class="screen">
            <a href="#" class="back-link" onclick="showScreen('screen-welcome')">&larr; Back</a>
            <h3>Employee Portal Login</h3>
            
            <div id="step-email-input">
                <label>Enter Registered Email ID</label>
                <input type="email" id="emp-login-email" placeholder="e.g. name@gmail.com">
                <button class="btn" onclick="sendOTP()">Send OTP</button>
            </div>

            <div id="step-otp-verify" style="display: none;">
                <p style="font-size: 13px; color: var(--blue);">OTP has been generated! (Demo OTP: <b id="display-otp">1234</b>)</p>
                <label>Enter 4-Digit OTP</label>
                <input type="text" id="emp-login-otp" placeholder="Enter OTP">
                <button class="btn" onclick="verifyOTP()">Verify & Login</button>
                <button class="btn btn-outline" onclick="resetLoginStep()">Back to Email</button>
            </div>
        </div>

        <!-- Employee Dashboard -->
        <div id="screen-employee-dashboard" class="screen">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                <h3 id="emp-welcome-title" style="margin:0;">Employee Panel</h3>
                <button class="btn-outline" style="padding: 5px 10px; width: auto; font-size: 12px; margin:0;" onclick="employeeLogout()">Logout</button>
            </div>

            <div class="tabs" style="margin-top: 15px;">
                <button class="tab-btn active" onclick="switchEmpTab('profile')">Profile</button>
                <button class="tab-btn" onclick="switchEmpTab('attendance')">Add Attendance</button>
                <button class="tab-btn" onclick="switchEmpTab('history')">History</button>
            </div>

            <!-- Profile Tab -->
            <div id="emp-tab-profile" style="margin-top: 15px;">
                <div class="card" id="profile-card-content">
                    <!-- Loaded dynamically -->
                </div>
            </div>

            <!-- Add Attendance Tab -->
            <div id="emp-tab-attendance" style="margin-top: 15px; text-align: center;">
                <h4>Mark Today's Attendance</h4>
                <p style="font-size: 13px; color: #666;">Face selfie verification is required.</p>
                <div id="camera-container" style="margin: 15px 0;">
                    <video id="video" width="100%" height="240" autoplay style="background:#000; border-radius:8px; display:none;"></video>
                    <canvas id="canvas" style="display:none;"></canvas>
                    <img id="selfie-preview" style="width: 100%; max-height: 240px; border-radius: 8px; display: none; object-fit: cover;" alt="Selfie Preview"/>
                </div>
                <button class="btn" id="btn-start-cam" onclick="startCamera()">Open Camera</button>
                <button class="btn" id="btn-capture" onclick="captureSelfie()" style="background: var(--secondary); display: none;">Capture Selfie & Submit</button>
            </div>

            <!-- Attendance History Tab -->
            <div id="emp-tab-history" style="margin-top: 15px;">
                <h4>Attendance History</h4>
                <div style="display: flex; gap: 10px;">
                    <select id="filter-year" onchange="renderCalendar()">
                        <option value="2026">2026</option>
                        <option value="2025">2025</option>
                    </select>
                    <select id="filter-month" onchange="renderCalendar()">
                        <option value="0">January</option>
                        <option value="1">February</option>
                        <option value="2" selected>March</option>
                        <option value="3">April</option>
                        <option value="4">May</option>
                        <option value="5">June</option>
                        <option value="6">July</option>
                        <option value="7">August</option>
                        <option value="8">September</option>
                        <option value="9">October</option>
                        <option value="10">November</option>
                        <option value="11">December</option>
                    </select>
                </div>
                <div class="calendar-grid" id="calendar-header-days" style="font-weight: bold; text-align: center; font-size: 11px; color:#555;">
                    <div>Su</div><div>Mo</div><div>Tu</div><div>We</div><div>Th</div><div>Fr</div><div>Sa</div>
                </div>
                <div class="calendar-grid" id="calendar-days">
                    <!-- Generated calendar days -->
                </div>
                <div class="stats-box">
                    <div>
                        <span style="font-size: 18px; font-weight: bold; color: var(--blue);" id="count-present">0</span><br>
                        <span style="font-size: 12px; color: #555;">Present Days (Blue)</span>
                    </div>
                    <div>
                        <span style="font-size: 18px; font-weight: bold; color: var(--red);" id="count-absent">0</span><br>
                        <span style="font-size: 12px; color: #555;">Absent Days (Red)</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Shared Data & Centralized LocalStorage simulation (Jiye bhi sehi email ru login karibe, same data dekhajiba)
    let employees = JSON.parse(localStorage.getItem('pec_employees')) || [
        { id: 'PEC101', name: 'Ramesh Kumar', email: 'ramesh@gmail.com', dob: '1998-05-12', aadhar: '123456789012', joining: '2025-01-10', position: 'Operator', photo: '', attendance: { '2026-2-1': 'present', '2026-2-2': 'present', '2026-2-3': 'absent' } }
    ];
    let currentLoggedEmpId = localStorage.getItem('pec_logged_emp') || null;
    let generatedOTP = '1234';
    let tempLoginEmail = '';

    function showScreen(screenId) {
        document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
        document.getElementById(screenId).classList.add('active');
        if(screenId === 'screen-owner-dashboard') loadOwnerHome();
        if(screenId === 'screen-employee-dashboard' && currentLoggedEmpId) loadEmployeeDashboard();
    }

    function verifyOwner() {
        const pwd = document.getElementById('owner-pwd').value;
        if(pwd === 'Prasanta@123') {
            document.getElementById('owner-pwd').value = '';
            showScreen('screen-owner-dashboard');
        } else {
            alert('Incorrect Password! Default is Prasanta@123');
        }
    }

    function switchOwnerTab(tab) {
        document.querySelectorAll('#screen-owner-dashboard .tab-btn').forEach(b => b.classList.remove('active'));
        if(tab === 'home') {
            document.querySelectorAll('#screen-owner-dashboard .tab-btn')[0].classList.add('active');
            document.getElementById('owner-tab-home').style.display = 'block';
            document.getElementById('owner-tab-add').style.display = 'none';
            loadOwnerHome();
        } else {
            document.querySelectorAll('#screen-owner-dashboard .tab-btn')[1].classList.add('active');
            document.getElementById('owner-tab-home').style.display = 'none';
            document.getElementById('owner-tab-add').style.display = 'block';
        }
    }

    function createEmployee() {
        const name = document.getElementById('emp-name').value;
        const email = document.getElementById('emp-email').value.trim().toLowerCase();
        const dob = document.getElementById('emp-dob').value;
        const aadhar = document.getElementById('emp-aadhar').value;
        const joining = document.getElementById('emp-joining').value;
        const position = document.getElementById('emp-position').value;
        const photoInput = document.getElementById('emp-photo');

        if(!name || !email || !aadhar) {
            alert('Please fill Name, Email and Aadhar number!');
            return;
        }

        const newId = 'PEC' + (100 + employees.length + 1);
        
        let reader = new FileReader();
        if(photoInput.files && photoInput.files[0]) {
            reader.readAsDataURL(photoInput.files[0]);
            reader.onload = function(e) {
                saveNewEmp(newId, name, email, dob, aadhar, joining, position, e.target.result);
            }
        } else {
            saveNewEmp(newId, name, email, dob, aadhar, joining, position, '');
        }
    }

    function saveNewEmp(id, name, email, dob, aadhar, joining, position, photo) {
        employees.push({
            id: id,
            name: name,
            email: email,
            dob: dob,
            aadhar: aadhar,
            joining: joining,
            position: position,
            photo: photo,
            attendance: {}
        });
        localStorage.setItem('pec_employees', JSON.stringify(employees));
        alert('Employee created successfully! ID: ' + id + ' | Email: ' + email);
        document.getElementById('emp-name').value = '';
        document.getElementById('emp-email').value = '';
        document.getElementById('emp-dob').value = '';
        document.getElementById('emp-aadhar').value = '';
        document.getElementById('emp-joining').value = '';
        document.getElementById('emp-position').value = '';
        document.getElementById('emp-photo').value = '';
        switchOwnerTab('home');
    }

    function loadOwnerHome() {
        // Refresh data from storage to keep synced across devices/sessions simulation
        employees = JSON.parse(localStorage.getItem('pec_employees')) || employees;
        const container = document.getElementById('employee-list-container');
        container.innerHTML = '';
        if(employees.length === 0) {
            container.innerHTML = '<p style="text-align:center; color:#777;">No employees added yet.</p>';
            return;
        }
        employees.forEach(emp => {
            let card = document.createElement('div');
            card.className = 'card';
            card.innerHTML = `
                <strong>${emp.name} (${emp.id})</strong><br>
                <span style="font-size:12px; color:#555;">Email: ${emp.email || 'N/A'} | Position: ${emp.position || 'N/A'}</span>
                <div style="margin-top: 8px; font-size: 13px; color: var(--primary);">
                    <span>Total Attendance Recorded: ${Object.keys(emp.attendance || {}).length} days</span>
                </div>
            `;
            container.appendChild(card);
        });
    }

    function filterEmployees() {
        const query = document.getElementById('search-employee').value.toLowerCase();
        const container = document.getElementById('employee-list-container');
        container.innerHTML = '';
        const filtered = employees.filter(e => e.name.toLowerCase().includes(query) || (e.email && e.email.toLowerCase().includes(query)) || e.id.toLowerCase().includes(query));
        if(filtered.length === 0) {
            container.innerHTML = '<p style="text-align:center; color:#777;">No employee found.</p>';
            return;
        }
        filtered.forEach(emp => {
            let card = document.createElement('div');
            card.className = 'card';
            card.innerHTML = `
                <strong>${emp.name} (${emp.id})</strong><br>
                <span style="font-size:12px; color:#555;">Email: ${emp.email || 'N/A'} | Position: ${emp.position || 'N/A'}</span>
            `;
            container.appendChild(card);
        });
    }

    // Email & OTP Login Flow
    function sendOTP() {
        const emailInput = document.getElementById('emp-login-email').value.trim().toLowerCase();
        if(!emailInput) {
            alert('Please enter your email ID!');
            return;
        }
        
        // Refresh employees list
        employees = JSON.parse(localStorage.getItem('pec_employees')) || employees;
        const emp = employees.find(e => e.email === emailInput);
        if(!emp) {
            alert('This email ID is not registered by the owner!');
            return;
        }

        tempLoginEmail = emailInput;
        generatedOTP = Math.floor(1000 + Math.random() * 9000).toString(); // Generate random 4-digit OTP
        document.getElementById('display-otp').innerText = generatedOTP;
        
        document.getElementById('step-email-input').style.display = 'none';
        document.getElementById('step-otp-verify').style.display = 'block';
    }

    function resetLoginStep() {
        document.getElementById('step-otp-verify').style.display = 'none';
        document.getElementById('step-email-input').style.display = 'block';
        document.getElementById('emp-login-otp').value = '';
    }

    function verifyOTP() {
        const enteredOtp = document.getElementById('emp-login-otp').value.trim();
        if(enteredOtp === generatedOTP) {
            employees = JSON.parse(localStorage.getItem('pec_employees')) || employees;
            const emp = employees.find(e => e.email === tempLoginEmail);
            if(emp) {
                currentLoggedEmpId = emp.id;
                localStorage.setItem('pec_logged_emp', currentLoggedEmpId);
                document.getElementById('emp-login-email').value = '';
                document.getElementById('emp-login-otp').value = '';
                resetLoginStep();
                showScreen('screen-employee-dashboard');
            }
        } else {
            alert('Incorrect OTP! Please check the displayed OTP code.');
        }
    }

    function employeeLogout() {
        currentLoggedEmpId = null;
        localStorage.removeItem('pec_logged_emp');
        showScreen('screen-welcome');
    }

    // Employee Dashboard Logic
    function switchEmpTab(tab) {
        document.querySelectorAll('#screen-employee-dashboard .tab-btn').forEach(b => b.classList.remove('active'));
        document.getElementById('emp-tab-profile').style.display = 'none';
        document.getElementById('emp-tab-attendance').style.display = 'none';
        document.getElementById('emp-tab-history').style.display = 'none';

        if(tab === 'profile') {
            document.querySelectorAll('#screen-employee-dashboard .tab-btn')[0].classList.add('active');
            document.getElementById('emp-tab-profile').style.display = 'block';
            loadEmpProfile();
        } else if(tab === 'attendance') {
            document.querySelectorAll('#screen-employee-dashboard .tab-btn')[1].classList.add('active');
            document.getElementById('emp-tab-attendance').style.display = 'block';
        } else if(tab === 'history') {
            document.querySelectorAll('#screen-employee-dashboard .tab-btn')[2].classList.add('active');
            document.getElementById('emp-tab-history').style.display = 'block';
            renderCalendar();
        }
    }

    function loadEmployeeDashboard() {
        employees = JSON.parse(localStorage.getItem('pec_employees')) || employees;
        const emp = employees.find(e => e.id === currentLoggedEmpId);
        if(!emp) {
            employeeLogout();
            return;
        }
        document.getElementById('emp-welcome-title').innerText = 'Welcome, ' + emp.name;
        loadEmpProfile();
        switchEmpTab('profile');
    }

    function loadEmpProfile() {
        employees = JSON.parse(localStorage.getItem('pec_employees')) || employees;
        const emp = employees.find(e => e.id === currentLoggedEmpId);
        if(!emp) return;

        const container = document.getElementById('profile-card-content');
        let photoHtml = emp.photo ? `<img src="${emp.photo}" style="width:80px; height:80px; border-radius:50%; object-fit:cover; margin-bottom:10px;" />` : `<div style="width:80px; height:80px; border-radius:50%; background:#ddd; display:flex; align-items:center; justify-content:center; margin:0 auto 10px; font-weight:bold; color:#555;">No Photo</div>`;

        container.innerHTML = `
            <div style="text-align: center;">
                ${photoHtml}
                <h3 style="margin:5px 0;">${emp.name}</h3>
                <p style="color: var(--secondary); margin:0; font-size:14px;"><b>ID:</b> ${emp.id} | <b>Position:</b> ${emp.position || 'N/A'}</p>
            </div>
            <hr style="border:0; border-top:1px solid #ddd; margin:15px 0;">
            <p style="font-size:14px; margin:6px 0;"><b>Email:</b> ${emp.email || 'N/A'}</p>
            <p style="font-size:14px; margin:6px 0;"><b>Aadhar Number:</b> ${emp.aadhar}</p>
            <p style="font-size:14px; margin:6px 0;"><b>Date of Birth:</b> ${emp.dob || 'N/A'}</p>
            <p style="font-size:14px; margin:6px 0;"><b>Joining Date:</b> ${emp.joining || 'N/A'}</p>
        `;
    }

    // Camera & Selfie Attendance
    let videoStream = null;
    function startCamera() {
        const video = document.getElementById('video');
        const btnStart = document.getElementById('btn-start-cam');
        const btnCapture = document.getElementById('btn-capture');

        navigator.mediaDevices.getUserMedia({ video: true, audio: false })
            .then(stream => {
                videoStream = stream;
                video.srcObject = stream;
                video.style.display = 'block';
                document.getElementById('selfie-preview').style.display = 'none';
                btnStart.style.display = 'none';
                btnCapture.style.display = 'block';
            })
            .catch(err => {
                alert('Camera access denied or not available!');
            });
    }

    function captureSelfie() {
        const video = document.getElementById('video');
        const canvas = document.getElementById('canvas');
        const preview = document.getElementById('selfie-preview');

        canvas.width = video.videoWidth || 300;
        canvas.height = video.videoHeight || 240;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(video, 0, 0, canvas.width, canvas.height);

        const dataUrl = canvas.toDataURL('image/png');
        preview.src = dataUrl;
        preview.style.display = 'block';
        video.style.display = 'none';

        if(videoStream) {
            videoStream.getTracks().forEach(track => track.stop());
        }

        document.getElementById('btn-start-cam').style.display = 'block';
        document.getElementById('btn-capture').style.display = 'none';

        // Mark Attendance for Today
        markAttendanceToday();
    }

    function markAttendanceToday() {
        employees = JSON.parse(localStorage.getItem('pec_employees')) || employees;
        const emp = employees.find(e => e.id === currentLoggedEmpId);
        if(!emp) return;

        const today = new Date();
        const year = today.getFullYear();
        const month = today.getMonth(); // 0-11
        const day = today.getDate();
        const dateKey = `${year}-${month}-${day}`;

        if(!emp.attendance) emp.attendance = {};
        emp.attendance[dateKey] = 'present';

        localStorage.setItem('pec_employees', JSON.stringify(employees));
        alert('Attendance marked successfully as PRESENT for today!');
        switchEmpTab('history');
    }

    // Calendar History Rendering
    function renderCalendar() {
        employees = JSON.parse(localStorage.getItem('pec_employees')) || employees;
        const emp = employees.find(e => e.id === currentLoggedEmpId);
        if(!emp) return;

        const year = parseInt(document.getElementById('filter-year').value);
        const month = parseInt(document.getElementById('filter-month').value);

        const calendarDaysContainer = document.getElementById('calendar-days');
        calendarDaysContainer.innerHTML = '';

        const firstDayIndex = new Date(year, month, 1).getDay();
        const totalDays = new Date(year, month + 1, 0).getDate();

        let presentCount = 0;
        let absentCount = 0;

        // Blank slots for previous month offset
        for(let i = 0; i < firstDayIndex; i++) {
            let emptyDiv = document.createElement('div');
            calendarDaysContainer.appendChild(emptyDiv);
        }

        // Days of current month
        for(let d = 1; d <= totalDays; d++) {
            let dayDiv = document.createElement('div');
            dayDiv.className = 'calendar-day';
            dayDiv.innerText = d;

            const dateKey = `${year}-${month}-${d}`;
            const status = emp.attendance ? emp.attendance[dateKey] : null;

            if(status === 'present') {
                dayDiv.classList.add('present');
                presentCount++;
            } else if(status === 'absent') {
                dayDiv.classList.add('absent');
                absentCount++;
            }
            calendarDaysContainer.appendChild(dayDiv);
        }

        document.getElementById('count-present').innerText = presentCount;
        document.getElementById('count-absent').innerText = absentCount;
    }

    // Auto-login check on page load
    window.onload = function() {
        if(currentLoggedEmpId) {
            showScreen('screen-employee-dashboard');
        }
    }
</script>
